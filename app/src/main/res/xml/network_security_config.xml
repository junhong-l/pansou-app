<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http 明文访问：内网后端如 http://192.168.x.x:1080 必须放行 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
